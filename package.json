{
  "name": "clavue-agent-sdk",
  "author": {
    "name": "mycode699",
    "url": "https://github.com/mycode699"
  },
  "homepage": "https://github.com/mycode699/clavue-agent-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mycode699/clavue-agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mycode699/clavue-agent-sdk/issues"
  },
  "version": "1.0.3",
  "description": "In-process TypeScript agent runtime with multi-agent graph DSL, live tracing, 4-scope guardrails, capability-token sandbox, RAG, framework-agnostic Generative UI, voice adapters, worker_thread subagent isolation, Anthropic prompt caching, streaming, and structured outputs. Anthropic + OpenAI-compatible.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "clavue-agent-sdk": "dist/cli.js",
    "clavue-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/subpath/core.d.ts",
      "import": "./dist/subpath/core.js"
    },
    "./tools": {
      "types": "./dist/subpath/tools.d.ts",
      "import": "./dist/subpath/tools.js"
    },
    "./contracts": {
      "types": "./dist/subpath/contracts.d.ts",
      "import": "./dist/subpath/contracts.js"
    },
    "./workflow": {
      "types": "./dist/subpath/workflow.d.ts",
      "import": "./dist/subpath/workflow.js"
    },
    "./retro": {
      "types": "./dist/subpath/retro.d.ts",
      "import": "./dist/subpath/retro.js"
    },
    "./testing": {
      "types": "./dist/subpath/testing.d.ts",
      "import": "./dist/subpath/testing.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js"
    },
    "./tracing": {
      "types": "./dist/tracing/index.d.ts",
      "import": "./dist/tracing/index.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox/index.d.ts",
      "import": "./dist/sandbox/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js"
    },
    "./genui": {
      "types": "./dist/genui/index.d.ts",
      "import": "./dist/genui/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsc --watch",
    "test": "npx tsx --test tests/*.test.ts",
    "test:all": "node --import tsx examples/16-background-agent-jobs.ts",
    "test:examples:live": "for f in examples/*.ts; do echo \"--- Running $f ---\"; npx tsx $f; echo; done",
    "test:examples:offline": "for f in examples/19-graph-dsl.ts examples/22-capability-tokens.ts examples/23-rag-retriever.ts examples/24-generative-ui.ts examples/25-voice.ts examples/32-tier-a-performance.ts; do echo \"--- Running $f ---\"; npx tsx $f || exit 1; echo; done",
    "bench": "for f in scripts/bench/*.ts; do echo \"\\n--- $f ---\"; npx tsx \"$f\"; done",
    "bench:tokens": "npx tsx scripts/bench/token-estimator.ts",
    "bench:worker": "npx tsx scripts/bench/worker-thread-latency.ts",
    "bench:engine": "npx tsx scripts/bench/engine-footprint.ts",
    "web": "npx tsx examples/web/server.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "clavue-agent-sdk",
    "agent-sdk",
    "ai-agent",
    "autonomous-agent",
    "coding-agent",
    "agentic",
    "llm",
    "tools",
    "mcp",
    "openai",
    "anthropic",
    "claude",
    "streaming",
    "prompt-caching",
    "structured-outputs",
    "multi-agent",
    "agent-graph",
    "guardrails",
    "tracing",
    "opentelemetry",
    "rag",
    "retriever",
    "pgvector",
    "sandbox",
    "capability-tokens",
    "generative-ui",
    "voice",
    "worker-threads",
    "workflow-automation",
    "ci-automation",
    "issue-workflow",
    "workflow-contract",
    "proof-of-work",
    "orchestration-policy",
    "typescript",
    "esm"
  ],
  "license": "MIT"
}
